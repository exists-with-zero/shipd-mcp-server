# The Shipd backend this server talks to (no /api/v1).
SHIPD_API_URL=http://localhost:8000
# Where people open their apps (used for links only).
SHIPD_APP_URL=http://localhost:3000
PORT=8787
# Bind address. 127.0.0.1 turns on the SDK's DNS rebinding protection.
# On Railway it defaults to 0.0.0.0 (see README, Deploying on Railway).
MCP_HOST=127.0.0.1
# Extra Host headers to accept when deployed (e.g. mcp.theshipd.com). On
# Railway the generated domain and the health checker are added on their own.
MCP_ALLOWED_HOSTS=
# Requests per minute from one client address before 429 (default 120).
MCP_RATE_PER_MIN=120
